# Supabase Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public Key (safe to use in client-side)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: These are the publishable/anonymous keys, not the service role keys
# The anon key is safe for client-side use and is restricted by RLS policies
